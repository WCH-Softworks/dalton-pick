<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission: the app never goes online (spec §5.5). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera mode only, asked for the first time it opens (spec §4.4). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The lens works without a camera; camera mode just isn't offered. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DaltonPick">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Camera mode: also reachable from the launcher shortcut. -->
        <activity
            android:name=".camera.CameraActivity"
            android:exported="false"
            android:label="@string/camera_title"
            android:theme="@style/Theme.DaltonPick" />

        <!-- Capture backend A: hosts the overlay and takes screenshots (spec §5.2). -->
        <service
            android:name=".DaltonAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Fallback host: MediaProjection capture with a regular overlay window. -->
        <service
            android:name=".ProjectionOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Quick Settings tile: show or hide the edge tab. -->
        <service
            android:name=".ToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_lens"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Notification button: hide or show the edge tab. -->
        <receiver
            android:name=".OverlayActionReceiver"
            android:exported="false" />
    </application>
</manifest>
